{
    "name": "@soliantconsulting/fm-saxml-delivery",
    "version": "0.0.0-managed-by-semantic-release",
    "description": "Download a filemaker container file after running a script.",
    "files": [
        "dist/**/*"
    ],
    "bin": {
        "fm-saxml-delivery": "./dist/cli.js"
    },
    "main": "index.js",
    "type": "module",
    "module": "es2022",
    "scripts": {
        "start": "tsx ./src/cli.ts",
        "build": "tsc",
        "test": "tsx --test test/*.test.ts",
        "format": "biome format . --write",
        "check": "biome check . --write"
    },
    "author": "Soliant Consulting",
    "license": "MIT",
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@tsconfig/node22": "^22.0.6",
        "@types/node": "^22.20.5",
        "tsx": "^4.23.15",
        "typescript": "~5.9.3"
    },
    "dependencies": {
        "dotenv": "^17.4.2",
        "fm-data-api-client": "^3.0.2"
    },
    "release": {
        "branches": [
            "main"
        ]
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/soliantconsulting/fm-saxml-delivery"
    }
}
